# This repo is the MCP *client* (Groww weekly pulse).
# Google Docs / Gmail are provided by:
#   https://github.com/Charu1806/MCPserverGoogleWorkspace

# Required before Groq.
GROQ_API_KEY=

# Optional. Default is qwen/qwen3.8-27b.
GROQ_MODEL=

# Required before the pulse run. Operator address or alias. Never a reviewer address.
PULSE_RECIPIENT=

# Overridden by --export. Default path of the downloaded reviews.
PULSE_EXPORT=data/exports/reviews.csv

# Allowed range is 8–12 when the export spans at least 8 weeks.
PULSE_WINDOW_WEEKS=12

# Remote Workspace MCP (Streamable HTTP). Same value for Docs + Gmail tools.
# Production: https://mc-pserver-google-workspace.vercel.app/mcp
# Local server: http://127.0.0.1:3000/mcp  (npm run start:http in the server repo)
MCP_URL=https://mc-pserver-google-workspace.vercel.app/mcp

# Must match MCP_API_KEY on the Vercel server. Sent as Authorization: Bearer …
MCP_API_KEY=

# Optional overrides (stdio command or http(s) URL). Blank → MCP_URL.
# Stdio example from the server README:
# DOCS_MCP_COMMAND=node /ABS/PATH/MCPserverGoogleWorkspace/dist/index.js
DOCS_MCP_COMMAND=
GMAIL_MCP_COMMAND=
